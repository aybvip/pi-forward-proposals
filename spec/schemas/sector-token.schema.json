{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aybvip/pi-forward-proposals/spec/schemas/sector-token.schema.json",
  "title": "Pi Multi-Sector Utility Token Metadata",
  "description": "A metadata record for CP-03. It describes claims and their verification level; it is not an endorsement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "token",
    "issuer",
    "sectors",
    "utility",
    "verification",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "asset_code", "issuer_account", "display_name"],
      "properties": {
        "network": {
          "enum": ["pi-testnet", "pi-mainnet"]
        },
        "asset_code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}$"
        },
        "issuer_account": {
          "type": "string",
          "pattern": "^G[A-Z2-7]{55}$",
          "description": "Synthetic or real Stellar-style issuer account. Examples use synthetic keys."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 280
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "jurisdiction", "contact_url", "kyb"],
      "properties": {
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$",
          "description": "ISO 3166-1 alpha-2 country, optionally with a region code."
        },
        "contact_url": {
          "type": "string",
          "format": "uri"
        },
        "kyb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence_url"],
          "properties": {
            "status": {
              "enum": ["none", "self-declared", "platform-verified", "third-party-verified"]
            },
            "evidence_url": {
              "type": "string",
              "format": "uri"
            },
            "verified_at": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "sectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "commerce",
          "education",
          "health",
          "infrastructure",
          "gaming",
          "social",
          "finance",
          "identity",
          "supply-chain",
          "energy",
          "media",
          "other"
        ]
      }
    },
    "utility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "redemption_channels", "terms_url", "availability"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "redemption_channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "url"],
            "properties": {
              "type": {
                "enum": ["app", "web", "physical", "api"]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "description": {
                "type": "string",
                "maxLength": 160
              }
            }
          }
        },
        "terms_url": {
          "type": "string",
          "format": "uri"
        },
        "availability": {
          "enum": ["global", "regional", "testnet-only"]
        }
      }
    },
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attested", "asset", "value", "as_of", "attestation_url", "attestor"],
      "properties": {
        "attested": {
          "type": "boolean"
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "attestation_url": {
          "type": "string",
          "format": "uri"
        },
        "attestor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["auditor", "url", "date"],
        "properties": {
          "auditor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "method", "evidence_url"],
      "properties": {
        "level": {
          "enum": ["L0", "L1", "L2", "L3"]
        },
        "method": {
          "enum": ["self-declaration", "domain-signature", "kyb-review", "reserve-attestation"]
        },
        "evidence_url": {
          "type": "string",
          "format": "uri"
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "public_key", "value", "signed_at"],
      "properties": {
        "scheme": {
          "enum": ["ed25519", "secp256k1", "other"]
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=_-]{32,128}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=_-]{32,256}$"
        },
        "signed_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
