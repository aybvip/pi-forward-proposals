{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aybvip/pi-forward-proposals/spec/schemas/utility-attestation.schema.json",
  "title": "Pi Utility Reserve Attestation",
  "description": "A signed snapshot used by CP-04 to compute a coverage ratio. It is a claim, not a guarantee.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_id",
    "issuer",
    "subscription_contract",
    "reserve",
    "outstanding_rewards",
    "coverage_ratio",
    "attestor",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "attestation_id": {
      "type": "string",
      "pattern": "^att_[A-Za-z0-9_-]{6,64}$"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "jurisdiction", "contact_url"],
      "properties": {
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
        },
        "contact_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "subscription_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "contract_id", "service_id"],
      "properties": {
        "network": {
          "enum": ["pi-testnet", "pi-mainnet"]
        },
        "contract_id": {
          "type": "string",
          "pattern": "^C[A-Z2-7]{55}$"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "PiRC2 service identifier."
        }
      }
    },
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "value", "as_of", "custodian", "evidence_url"],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "custodian": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "evidence_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "outstanding_rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "value", "as_of", "method"],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "coverage_ratio": {
      "type": "number",
      "minimum": 0
    },
    "attestor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "url", "signature"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "public_key", "value", "signed_at"],
          "properties": {
            "scheme": {
              "enum": ["ed25519", "secp256k1", "other"]
            },
            "public_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/=_-]{32,128}$"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/=_-]{32,256}$"
            },
            "signed_at": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    }
  }
}
